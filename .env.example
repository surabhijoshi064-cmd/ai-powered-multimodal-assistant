# =====================================================================
# Application Configuration
# =====================================================================
APP_NAME="Secure Multimodal AI Chatbot"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# =====================================================================
# Database Configuration (MySQL)
# Example: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Safe local default: sqlite:///./storage/local_fallback.db if MySQL not configured
# =====================================================================
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/chatbot_db"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# =====================================================================
# CORS Origins (Comma-separated)
# =====================================================================
CORS_ORIGINS="http://localhost:8501,http://127.0.0.1:8501"

# =====================================================================
# File Upload Limits & Storage Directories
# =====================================================================
MAX_UPLOAD_SIZE_BYTES=10485760   # 10 MB limit
ALLOWED_DOCUMENT_EXTENSIONS="pdf,txt"
ALLOWED_IMAGE_EXTENSIONS="png,jpg,jpeg"
ALLOWED_AUDIO_EXTENSIONS="wav,mp3,m4a,ogg"
STORAGE_DIR="storage"
UPLOAD_DIR="storage/uploads"
AUDIO_DIR="storage/audio"

# =====================================================================
# AI Provider Configuration
# Supported providers: gemini, openai, groq, ollama, mock
# =====================================================================

# ── Option A: Google Gemini (Primary Cloud Provider) ───────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""                        # paste your key here: AIza...
GEMINI_TEXT_MODEL="gemini-1.5-flash"      # or gemini-2.0-flash, gemini-1.5-pro
GEMINI_IMAGE_MODEL="gemini-1.5-flash"     # for image understanding
GEMINI_AUDIO_INPUT_MODEL="gemini-1.5-flash" # explicitly for audio input (never a -tts model!)
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts" # speech generation model
GEMINI_IMAGEN_MODEL="imagen-3.0-generate-002"

# ── Gemini Rate Limiting (free tier = 5 RPM) ──────────────────────────
GEMINI_RPM_LIMIT=4                       # requests per minute (safety margin below 5 RPM)
GEMINI_MAX_RETRIES=3                     # max retry attempts on transient 429
QUOTA_DEFAULT_COOLDOWN_SECONDS=3600      # cooldown in seconds if provider gives no Retry-After

# ── Option B: Ollama (Local AI — Free, Private, Automatic Fallback) ───
# Install from: https://ollama.com/download (Windows)
# Recommended models:
#   Text: gemma2:2b (fast, lightweight, ~1.6 GB)
#   Vision: moondream (~1.8 GB) or llava:7b (~4.7 GB)
OLLAMA_ENABLED=true                      # set to true to enable local fallback
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_TEXT_MODEL="gemma2:2b"
OLLAMA_VISION_MODEL="moondream"
OLLAMA_TIMEOUT=120.0
OLLAMA_FALLBACK_ON_DAILY_QUOTA=true

# Vision Provider
VISION_PROVIDER="mock"           # "openai", "groq", or "mock"
VISION_MODEL="gpt-4o-mini"
VISION_API_KEY=""

# ── Option C: ComfyUI (Local Image Generation & Editing Engine) ────────
COMFYUI_ENABLED=false
COMFYUI_BASE_URL="http://127.0.0.1:8188"
COMFYUI_TIMEOUT=180.0
COMFYUI_MODEL="v1-5-pruned-emaonly.safetensors"

# Transcription (Speech-to-Text) Provider
TRANSCRIPTION_PROVIDER="mock"    # "openai" or "mock"
TRANSCRIPTION_MODEL="whisper-1"
TRANSCRIPTION_API_KEY=""

# Text-to-Speech (TTS) Provider
TTS_PROVIDER="mock"              # "openai" or "mock"
TTS_MODEL="tts-1"
TTS_VOICE="alloy"
TTS_API_KEY=""

# Embeddings & RAG Configuration
EMBEDDING_PROVIDER="mock"        # "mock" (built-in semantic hash) or "openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_API_KEY=""

RAG_CHUNK_SIZE=500               # chunk size in characters
RAG_CHUNK_OVERLAP=100            # overlap in characters
RAG_TOP_K=4                      # number of chunks to retrieve
RAG_SIMILARITY_THRESHOLD=0.35    # minimum similarity score to include in context

# =====================================================================
# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# =====================================================================
LOG_LEVEL="INFO"
